BENCHMARK_SOURCES := \
	src/adlist.c \
	src/ae.c \
	src/anet.c \
	src/cli_common.c \
	src/crc16.c \
	src/crc64.c \
	src/crcspeed.c \
	src/dict.c \
	src/monotonic.c \
	src/mt19937-64.c \
	src/redis-benchmark.c \
