	$(addprefix $(BUILD)/interop-test/,$(INTEROP_TEST_CXX_SOURCES:.cpp=.o))

CLI_SOURCES := \
	deps/linenoise/linenoise.c \
	src/adlist.c \
	src/ae.c \
	src/anet.c \
	src/cli_common.c \
	src/crc16.c \
	src/crc64.c \
	src/crcspeed.c \
	src/dict.c \
	src/monotonic.c \
	src/mt19937-64.c \
	src/redis-cli.c \
