# MinGW build harness for the Redis Windows port.
#
# This is intentionally separate from the upstream-style POSIX Makefile and the
# legacy Visual Studio project files. It is the first-class build for the
# current WSL/MSYS2 development environment.

BUILD ?= build/mingw64
BUILD_BUNDLED_MODULES ?= no
SKIP_VEC_SETS ?= yes

ifneq ($(BUILD_BUNDLED_MODULES),no)
$(error Bundled Redis modules are outside the initial Windows core-only port)
endif
ifneq ($(SKIP_VEC_SETS),yes)
$(error Vector Sets are temporarily excluded from the Windows core-only bring-up)
endif

JEMALLOC_SRC := deps/jemalloc
JEMALLOC_BUILD := $(BUILD)/jemalloc
JEMALLOC_ABS_SRC := $(abspath $(JEMALLOC_SRC))
WIN32_INTEROP_ABS := $(abspath src/Win32_Interop)

CC := gcc
CXX := g++
AR := ar
RANLIB := ranlib
WINDRES := windres

EVENTLOG_RC := src/Win32_Interop/resources/EventLog.rc
EVENTLOG_MESSAGE := src/Win32_Interop/resources/EventLog_MSG00409.bin
EVENTLOG_OBJ := $(BUILD)/eventlog/EventLog.o
EVENTLOG_DLL := $(BUILD)/EventLog.dll

BASE_DEFS := \
	-DWIN32 \
	-D_WIN32 \
	-DWIN32_LEAN_AND_MEAN \
	-DNOGDI \
	-D__USE_W32_SOCKETS \
	-D_FILE_OFFSET_BITS=64 \
	-D__USE_MINGW_ANSI_STDIO=1 \
	-DLACKS_STDLIB_H \
	-D_CRT_SECURE_NO_WARNINGS \
	-DREDIS_STATIC='' \
	-DPSAPI_VERSION=1 \
	-DENABLE_CJSON_GLOBAL

BASE_INCLUDES := \
	-Ideps/hiredis \
	-Isrc \
	-Ideps/linenoise \
	-Ideps/lua/src \
	-Ideps/hdr_histogram \
	-Ideps/fpconv \
	-Ideps/fast_float \
	-Ideps/xxhash \
	-Ideps/geohash-int \
	-I$(JEMALLOC_BUILD)/include \
	-I$(JEMALLOC_SRC)/include

WARNINGS := \
	-Wall \
	-Wextra \
	-Wno-unknown-pragmas \
	-Wno-unused-parameter

OPT ?= -O2 -g

BASE_CFLAGS := $(OPT) $(WARNINGS) $(BASE_DEFS) $(BASE_INCLUDES)
BASE_CXXFLAGS := $(OPT) $(WARNINGS) $(BASE_DEFS) $(BASE_INCLUDES)

FDAPI_SYSTEM_REDEFS := \
	-Daccept=redis_mingw_system_accept \
	-Daccess=redis_mingw_system_access \
	-Dbind=redis_mingw_system_bind \
	-Dconnect=redis_mingw_system_connect \
	-Dfreeaddrinfo=redis_mingw_system_freeaddrinfo \
	-Dgetaddrinfo=redis_mingw_system_getaddrinfo \
	-Dgetpeername=redis_mingw_system_getpeername \
	-Dgetsockname=redis_mingw_system_getsockname \
	-Dgetsockopt=redis_mingw_system_getsockopt \
	-Dhtonl=redis_mingw_system_htonl \
	-Dhtons=redis_mingw_system_htons \
	-Dinet_ntop=redis_mingw_system_inet_ntop \
	-Dinet_pton=redis_mingw_system_inet_pton \
	-Disatty=redis_mingw_system_isatty \
	-Dlisten=redis_mingw_system_listen \
	-Dlseek64=redis_mingw_system_lseek64 \
	-Dntohl=redis_mingw_system_ntohl \
	-Dntohs=redis_mingw_system_ntohs \
	-Dopen=redis_mingw_system_open \
	-Dread=redis_mingw_system_read \
	-Dselect=redis_mingw_system_select \
	-Dsetsockopt=redis_mingw_system_setsockopt \
	-Dsocket=redis_mingw_system_socket \
	-Dwrite=redis_mingw_system_write \
	-Dgai_strerror=redis_mingw_system_gai_strerror \
	-Dgai_strerrorA=redis_mingw_system_gai_strerrorA \
	-Dgai_strerrorW=redis_mingw_system_gai_strerrorW

SERVER_CFLAGS := $(BASE_CFLAGS) $(FDAPI_SYSTEM_REDEFS) -std=gnu11 -DUSE_JEMALLOC
SERVER_CXXFLAGS := $(BASE_CXXFLAGS) -std=gnu++11 -DUSE_JEMALLOC -DUSE_STATIC
TOOL_CFLAGS := $(BASE_CFLAGS) $(FDAPI_SYSTEM_REDEFS) -std=gnu11 -DNO_QFORKIMPL
TOOL_CXXFLAGS := $(BASE_CXXFLAGS) -std=gnu++11 -DNO_QFORKIMPL
HIREDIS_CFLAGS := $(BASE_CFLAGS) $(FDAPI_SYSTEM_REDEFS) -std=gnu11 -DNO_QFORKIMPL
LUA_CFLAGS := $(BASE_CFLAGS) -std=gnu11 -DNO_QFORKIMPL
HDR_HISTOGRAM_CFLAGS := $(BASE_CFLAGS) -std=gnu11 -DNO_QFORKIMPL -DHDR_MALLOC_INCLUDE=\"hdr_redis_malloc.h\"
FAST_FLOAT_CXXFLAGS := $(SERVER_CXXFLAGS) -DFASTFLOAT_ALLOWS_LEADING_PLUS
XXHASH_CFLAGS := $(BASE_CFLAGS) -std=gnu11 -DNO_QFORKIMPL
TEST_MODULE_CFLAGS := $(OPT) $(WARNINGS) -std=gnu11 -Isrc
TEST_MODULE_LDFLAGS := -shared -static-libgcc -no-pthread -Wl,--export-all-symbols
TEST_MODULE_LDLIBS := -Wl,-Bstatic -lwinpthread -Wl,-Bdynamic
TEST_LAUNCHER_CFLAGS := $(OPT) $(WARNINGS) -std=gnu11
TEST_LAUNCHER_LDFLAGS := -municode -mwindows

LDFLAGS_COMMON := \
	-no-pthread \
	-static-libgcc \
	-static-libstdc++ \
	-Wl,--disable-dynamicbase \
	-Wl,--disable-high-entropy-va

LDLIBS_COMMON := \
	-lws2_32 \
	-lpsapi \
	-ldbghelp \
	-lshlwapi \
	-ladvapi32 \
	-lshell32 \
	-luser32 \
	-lgdi32 \
	-lwinspool

REDIS_HEADERS := $(wildcard src/*.h src/Win32_Interop/*.h deps/geohash-int/*.h deps/hiredis/*.h deps/linenoise/*.h)
HIREDIS_HEADERS := $(wildcard deps/hiredis/*.h)
LUA_HEADERS := $(wildcard deps/lua/src/*.h)
HDR_HISTOGRAM_HEADERS := $(wildcard deps/hdr_histogram/*.h)
FPCONV_HEADERS := $(wildcard deps/fpconv/*.h)
FAST_FLOAT_HEADERS := $(wildcard deps/fast_float/*.h)
XXHASH_HEADERS := $(wildcard deps/xxhash/*.h)

